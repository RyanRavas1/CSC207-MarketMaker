<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle rules for CSC207-MarketMaker.

  These encode the conventions already written down in docs/CODE_STYLE.md, plus the
  standard correctness and naming checks. We deliberately did NOT adopt google_checks
  or sun_checks wholesale: both forbid the single-line getter style our guide asks for,
  so importing them would have meant a config that disagrees with our own documentation.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- docs/CODE_STYLE.md: no tabs, no trailing whitespace, file ends with a newline -->
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace."/>
    </module>

    <!-- docs/CODE_STYLE.md: "Space between // and the text." URLs are exempt. -->
    <module name="RegexpSingleline">
        <property name="format" value="(?&lt;!:)//(?![/ ]|$)"/>
        <property name="message" value="Put a space after // in a comment."/>
    </module>

    <!-- docs/CODE_STYLE.md: no stray blank line before a closing brace -->
    <module name="RegexpMultiline">
        <property name="format" value="\n[ \t]*\n[ \t]*\}"/>
        <property name="message" value="Blank line before a closing brace."/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*\*.*https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- Naming, per docs/CODE_STYLE.md -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="PackageName"/>

        <!-- Imports: unused or star imports make the dependency graph hard to read,
             which matters when we are arguing that the Dependency Rule holds. -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- Correctness -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="NeedBraces"/>
        <module name="OneStatementPerLine"/>

        <!-- Utility classes (Money, A11y, Background) must not be instantiable -->
        <module name="HideUtilityClassConstructor"/>
        <module name="FinalClass"/>

        <!-- Spacing -->
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>

        <!-- Modifier order: "public static final", not "static public final" -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Every public class should say what it is for. Method-level Javadoc is not
             required: our guide prefers a comment that explains why over ceremony. -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
    </module>
</module>
